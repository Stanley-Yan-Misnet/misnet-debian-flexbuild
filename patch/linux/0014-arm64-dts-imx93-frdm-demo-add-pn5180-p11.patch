Subject: [PATCH] arm64: dts: imx93-frdm-demo: add PN5180 on P11 SPI3

Use the FRDM board's existing LPSPI3 routing on P11 for PN5180.
Disable the on-board Wi-Fi SPI level shifter while using external SPI.
Assign adjacent P11 pins 27 and 28 to BUSY and RESET_N. Keep the
Waveshare I2C4 and power setup in the FRDM demo overlay unchanged.

The PN5180 device is intended for userspace spidev binding; this patch
does not add a kernel PN5180 driver.

---
diff --git a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-waveshare-7inch-c-panel-p11.dtso b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-waveshare-7inch-c-panel-p11.dtso
--- a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-waveshare-7inch-c-panel-p11.dtso
+++ b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-waveshare-7inch-c-panel-p11.dtso
@@ -4,6 +4,7 @@
  * Copyright 2026 Misnet
  */
 
+#include <dt-bindings/gpio/gpio.h>
 #include "imx93-pinfunc.h"
 
 /dts-v1/;
@@ -10,6 +11,11 @@
 /plugin/;
 
 /* P11 pins 3/5 use LPI2C4; the NXP panel overlay uses LPI2C1 on P12. */
+&reg_vexp_3v3 {
+	regulator-boot-on;
+	regulator-always-on;
+};
+
 &reg_vexp_5v {
 	regulator-boot-on;
 	regulator-always-on;
@@ -127,6 +133,27 @@
 	status = "disabled";
 };
 
+/* P11: CS=24, MISO=21, MOSI=19, SCK=23, BUSY=27, RESET_N=28. */
+&gpio2 {
+	gpio-line-names = "pn5180-busy", "pn5180-reset";
+};
+
+&lpspi3 {
+	pinctrl-0 = <&pinctrl_lpspi3>, <&pinctrl_pn5180_gpio>;
+	/* Keep the on-board Wi-Fi SPI level shifter off for the P11 PN5180. */
+	pinctrl-assert-gpios = <&pcal6408 0 GPIO_ACTIVE_LOW>;
+};
+
+/* Userspace binds this device to spidev; no PN5180 kernel driver is present. */
+&spidev0 {
+	compatible = "nxp,pn5180";
+	spi-max-frequency = <1000000>;
+};
+
+&{/aliases} {
+	spi3 = "/soc@0/bus@42000000/spi@42550000";
+};
+
 &iomuxc {
 	pinctrl_lpi2c4_p11: lpi2c4p11grp {
 		fsl,pins = <
@@ -134,4 +161,11 @@
 			MX93_PAD_GPIO_IO03__LPI2C4_SCL	0x40000b9e
 		>;
 	};
+
+	pinctrl_pn5180_gpio: pn5180gpiogrp {
+		fsl,pins = <
+			MX93_PAD_GPIO_IO00__GPIO2_IO00	0x31e /* BUSY input */
+			MX93_PAD_GPIO_IO01__GPIO2_IO01	0x31e /* RESET_N output */
+		>;
+	};
 };
